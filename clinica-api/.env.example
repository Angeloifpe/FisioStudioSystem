# Conexão com o PostgreSQL (troque <sua-senha> pela senha do usuário postgres)
DATABASE_URL=postgresql://postgres:<sua-senha>@localhost:5432/clinica

# Porta da API
PORT=3333

# Chave usada para assinar os tokens de login (troque por um texto longo e aleatório)
JWT_SECRET=troque-esta-chave-por-um-texto-longo-e-aleatorio

# Validade do token de login
JWT_EXPIRES_IN=7d

# Fuso usado para "atendimentos do dia"
TIMEZONE=America/Sao_Paulo
